FROM golang:1.23 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -trimpath -o /out/e2e-telemetry-backend ./cmd/e2e-telemetry-backend

FROM gcr.io/distroless/static:nonroot

COPY --from=build /out/e2e-telemetry-backend /e2e-telemetry-backend

USER 65532:65532
ENTRYPOINT ["/e2e-telemetry-backend"]
