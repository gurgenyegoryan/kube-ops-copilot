Output docs/demo/smart-remediate-approval.gif

Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 900
Set Theme "Dracula"
Set TypingSpeed 35ms

Type "./kube-ops-copilot smart-remediate --llm-provider openai --llm-model gpt-5.2 --infra-repo-path ~/infra/live/prod --approval-provider n8n --wait-approval"
Enter
Sleep 4s
